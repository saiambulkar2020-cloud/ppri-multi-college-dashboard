# Public values from Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Secret server-only value. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Your production Vercel URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Platform administrator access is set in Supabase public.profiles.role.
# Exactly one profile can be admin. ADMIN_EMAILS is no longer used.

# Required for the short-lived administrator session, in demo AND Supabase modes.
# Generate with npm run auth:setup; store it only in server environment variables.
ACCESS_SESSION_SECRET=

# Local/demo-only credentials. Ignored completely when Supabase is configured.
# npm run auth:setup creates the ID, salted password hash, and session secret.
# In .env files, escape each $ in the hash as \$ (the setup command does this).
ACCESS_ADMIN_ID=
ACCESS_ADMIN_PASSWORD_HASH=
